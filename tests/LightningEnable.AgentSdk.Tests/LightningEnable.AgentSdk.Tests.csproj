<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LightningEnable.AgentSdk\LightningEnable.AgentSdk.csproj" />
  </ItemGroup>

  <!-- Shared port-drift conformance vectors (see conformance/README.md).
       Linked from the repo-root conformance/ dir and copied next to the test
       DLL so ConformanceTests can read them at runtime. dotnet build copies them,
       so a no-build test run in CI still finds them. -->
  <ItemGroup>
    <None Include="..\..\conformance\vectors\*.json"
          Link="conformance\vectors\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\conformance\CHECKSUMS"
          Link="conformance\CHECKSUMS"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

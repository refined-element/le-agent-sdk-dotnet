<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>LightningEnable.AgentSdk</PackageId>
    <Version>0.3.3</Version>
    <Description>SDK for Lightning Enable Agent Service Agreements on Nostr</Description>
    <Authors>Lightning Enable</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/refined-element/le-agent-sdk-dotnet</RepositoryUrl>
    <PackageProjectUrl>https://github.com/refined-element/le-agent-sdk-dotnet</PackageProjectUrl>
    <PackageTags>nostr;lightning;l402;agents;bitcoin;asa;sdk;agent-commerce</PackageTags>
    <PackageReleaseNotes>0.3.3 — Docs: Quick Start now points at the Lightning Enable agent relay (wss://agents.lightningenable.com) for ASA events (kinds 38400-38403); tagline corrected to "request services".</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NBitcoin.Secp256k1" Version="3.2.0" />
  </ItemGroup>

</Project>
